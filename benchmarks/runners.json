{
  "schema_version": 2,
  "runners": [
    {
      "id": "edgebench-native",
      "kind": "native-profile",
      "controller": "experiments/edgebench/experiment.py",
      "evidence_filename": "comparison.json",
      "supported_methods": [
        "plain-codex",
        "goal-plus-codex",
        "plain-claude",
        "plain-pi",
        "goal-plus-pi",
        "goal-plus-pi-provider"
      ],
      "method_contracts": {
        "goal-plus-pi-provider": {
          "model_format": "provider/model"
        }
      },
      "capabilities": {
        "provision": true,
        "detach": true,
        "stop": true,
        "resume": false,
        "cell_concurrency": true,
        "retain_containers": false,
        "official_evaluator": true,
        "resume_semantics": "stopped campaigns are finalized as partial; retry uses a new campaign"
      }
    },
    {
      "id": "swe-bench-native",
      "kind": "native-profile",
      "controller": "experiments/swe_bench_verified/experiment.py",
      "evidence_filename": "campaign-summary.json",
      "supported_methods": [
        "plain-codex",
        "plain-pi",
        "goal-plus-pi"
      ],
      "method_contracts": {
        "plain-codex": {
          "bootstrap_targets": ["swebench"],
          "max_cell_concurrency": 2
        },
        "plain-pi": {
          "bootstrap_targets": ["swebench"],
          "model_format": "provider/model",
          "max_cell_concurrency": 2
        },
        "goal-plus-pi": {
          "bootstrap_targets": ["swebench", "goal_plus"],
          "model_format": "provider/model",
          "max_cell_concurrency": 1
        }
      },
      "capabilities": {
        "provision": false,
        "detach": true,
        "stop": false,
        "resume": false,
        "cell_concurrency": true,
        "retain_containers": true,
        "official_evaluator": true,
        "resume_semantics": "Plain Codex and Plain Pi support up to two detached non-resumable task cells; Goal Plus + Pi supports one; every retry uses a new campaign"
      }
    },
    {
      "id": "common-matrix",
      "kind": "common-matrix",
      "controller": "experiments/benchmark_campaign/experiment.py",
      "evidence_filename": "campaign-summary.json",
      "supported_methods": [
        "plain-codex",
        "goal-plus-codex",
        "goal-plus-pi",
        "skydiscover-best-of-n",
        "skydiscover-evox",
        "skydiscover-adaevolve"
      ],
      "capabilities": {
        "provision": false,
        "detach": false,
        "stop": false,
        "resume": true,
        "cell_concurrency": false,
        "retain_containers": false,
        "official_evaluator": true,
        "resume_semantics": "rerun only prepared or interrupted cells"
      }
    },
    {
      "id": "openevolve-batch",
      "kind": "openevolve-batch",
      "controller": "experiments/openevolve_compare/experiment.py",
      "evidence_filename": "campaign-summary.json",
      "supported_methods": [
        "openevolve",
        "plain-codex",
        "goal-plus-codex",
        "goal-plus-pi"
      ],
      "capabilities": {
        "provision": false,
        "detach": false,
        "stop": false,
        "resume": true,
        "cell_concurrency": false,
        "retain_containers": false,
        "official_evaluator": true,
        "resume_semantics": "run-batch skips cells already present in campaign-results.json"
      }
    }
  ],
  "targets": [
    {
      "id": "edgebench",
      "runner": "edgebench-native",
      "adapter": null,
      "bootstrap_targets": ["edgebench"],
      "local_asset_inventory": true,
      "default_inventory_profile": "vliw-smoke",
      "docker": {
        "requirement": "required",
        "owner": "runner",
        "provision_mode": "eager",
        "scope": "Native SForge owns task work containers, hidden judges, image provisioning, and official finalization."
      }
    },
    {
      "id": "swe-bench-verified",
      "runner": "swe-bench-native",
      "adapter": null,
      "bootstrap_targets": ["swebench", "goal_plus"],
      "local_asset_inventory": true,
      "default_inventory_profile": "sympy-16886-codex-smoke",
      "docker": {
        "requirement": "required",
        "owner": "runner",
        "provision_mode": "external",
        "scope": "The Agent runs in the exact task evaluation image; the official SWE-bench harness owns a separate final evaluation container. The image is retained, and optional debug mode stops and retains the Agent container. No host-only score path is supported."
      }
    },
    {
      "id": "ale-bench-lite",
      "runner": "common-matrix",
      "adapter": "ale-bench-lite",
      "bootstrap_targets": ["ale_bench"],
      "local_asset_inventory": true,
      "default_inventory_profile": "ahc027-cpp20-202301",
      "docker": {
        "requirement": "required",
        "owner": "adapter",
        "provision_mode": "lazy",
        "scope": "The adapter invokes the benchmark-owned C++ and judge images when evaluation starts."
      }
    },
    {
      "id": "autolab-toy-isa",
      "runner": "common-matrix",
      "adapter": "autolab-toy-isa",
      "bootstrap_targets": ["autolab"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The integrated toy_isa_opt task uses the host compiler and make; other AutoLab tasks may declare their own Docker contract later."
      }
    },
    {
      "id": "frontier-cs-problem-0",
      "runner": "common-matrix",
      "adapter": "frontier-cs-problem-0",
      "bootstrap_targets": ["frontier_cs"],
      "local_asset_inventory": true,
      "default_inventory_profile": "problem-0",
      "docker": {
        "requirement": "required",
        "owner": "adapter",
        "provision_mode": "eager",
        "scope": "Setup builds the pinned Frontier-CS judge image and creates its preserved isolated evaluator container through adapter hooks."
      }
    },
    {
      "id": "frontier-engineering-malloclab",
      "runner": "common-matrix",
      "adapter": "frontier-engineering-malloclab",
      "bootstrap_targets": ["frontier_engineering"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The integrated MallocLab path uses the host C compiler and make."
      }
    },
    {
      "id": "heurigym",
      "runner": "common-matrix",
      "adapter": "heurigym",
      "bootstrap_targets": ["heurigym"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The registered task runs in the repository-managed Python environment."
      }
    },
    {
      "id": "local-vliw",
      "runner": "common-matrix",
      "adapter": "local-vliw",
      "bootstrap_targets": ["goal_plus"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "This local diagnostic task uses repository-hosted fixtures and tools."
      }
    },
    {
      "id": "openevolve-cpu-portable",
      "runner": "openevolve-batch",
      "adapter": null,
      "bootstrap_targets": ["openevolve"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The screened cpu_portable task set runs in the locked NumPy/SciPy environment without Docker."
      }
    }
  ],
  "presets": [
    {
      "id": "edgebench-vliw-codex-local-smoke",
      "description": "One-task local Plain Codex smoke using an explicit non-official open-network protocol override.",
      "benchmarks": ["edgebench"],
      "profile": "vliw-codex-sol-medium-local-smoke",
      "campaign_id_template": "edgebench-vliw-codex-gpt-5-6-sol-medium-local-smoke-5m-k1-c1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["plain-codex"],
        "model": "gpt-5.6-sol",
        "reasoning_effort": "medium",
        "wall_time_seconds": 300,
        "concurrency": 1,
        "cell_concurrency": 1
      }
    },
    {
      "id": "edgebench-codex-2h",
      "description": "Example full 51-task Plain Codex campaign; not a benchmark-run default.",
      "benchmarks": ["edgebench"],
      "profile": "full-codex-2h",
      "campaign_id_template": "edgebench-51-codex-gpt-5-6-sol-medium-2h-k1-c2-{timestamp}",
      "expected_profile": {
        "task_count": 51,
        "methods": ["plain-codex"],
        "model": "gpt-5.6-sol",
        "reasoning_effort": "medium",
        "wall_time_seconds": 7200,
        "concurrency": 1,
        "cell_concurrency": 2
      }
    },
    {
      "id": "edgebench-vliw-pi-local-smoke",
      "description": "One-task local Plain Pi smoke using the host openai-codex login.",
      "benchmarks": ["edgebench"],
      "profile": "vliw-pi-sol-medium-local-smoke",
      "campaign_id_template": "edgebench-vliw-pi-gpt-5-6-sol-medium-local-smoke-5m-k1-c1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["plain-pi"],
        "model": "gpt-5.6-sol",
        "reasoning_effort": "medium",
        "wall_time_seconds": 300,
        "concurrency": 1,
        "cell_concurrency": 1
      }
    },
    {
      "id": "edgebench-vliw-goal-plus-pi-local-smoke",
      "description": "One-task local Goal Plus + Pi smoke with two live search workers.",
      "benchmarks": ["edgebench"],
      "profile": "vliw-goal-plus-pi-sol-medium-local-smoke",
      "campaign_id_template": "edgebench-vliw-goal-plus-pi-gpt-5-6-sol-medium-local-smoke-10m-k2-c1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["goal-plus-pi"],
        "model": "gpt-5.6-sol",
        "reasoning_effort": "medium",
        "wall_time_seconds": 600,
        "concurrency": 2,
        "cell_concurrency": 1
      }
    },
    {
      "id": "edgebench-vliw-goal-plus-pi-glm-provider-1h",
      "description": "One-task Goal Plus + Pi campaign using the explicit glm-proxy/GLM-5.2 API provider with T=3600, K=2, C=1, R=1.",
      "benchmarks": ["edgebench"],
      "profile": "vliw-goal-plus-pi-glm-5-2-provider-1h-k2-c1",
      "campaign_id_template": "edgebench-vliw-goal-plus-pi-glm-5-2-provider-1h-k2-c1-r1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["goal-plus-pi-provider"],
        "model": "glm-proxy/GLM-5.2",
        "reasoning_effort": "high",
        "wall_time_seconds": 3600,
        "concurrency": 2,
        "cell_concurrency": 1
      }
    },
    {
      "id": "edgebench-vliw-goal-plus-pi-zai-glm-5-2-1h",
      "description": "One-task Goal Plus + Pi campaign using Pi's built-in zai/glm-5.2 provider with T=3600, K=2, C=1, R=1.",
      "benchmarks": ["edgebench"],
      "profile": "vliw-goal-plus-pi-zai-glm-5-2-1h-k2-c1",
      "campaign_id_template": "edgebench-vliw-goal-plus-pi-zai-glm-5-2-1h-k2-c1-r1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["goal-plus-pi-provider"],
        "model": "zai/glm-5.2",
        "reasoning_effort": "high",
        "wall_time_seconds": 3600,
        "concurrency": 2,
        "cell_concurrency": 1
      }
    },
    {
      "id": "swe-bench-verified-sympy-16886-codex-smoke",
      "description": "One-instance SWE-bench Verified Plain Codex official-harness smoke with T=1800, K=1, C=1, R=1.",
      "benchmarks": ["swe-bench-verified"],
      "profile": "sympy-16886-codex-smoke",
      "campaign_id_template": "swe-bench-verified-sympy-16886-plain-codex-30m-k1-c1-r1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["plain-codex"],
        "model": "gpt-5.6-sol",
        "reasoning_effort": "medium",
        "agent_provider": {
          "id": "bench_proxy",
          "name": "Benchmark OpenAI-compatible proxy",
          "auth_mode": "openai-compatible",
          "base_url_env": "OPENAI_BASE_URL",
          "api_key_env": "OPENAI_API_KEY",
          "wire_api": "responses"
        },
        "wall_time_seconds": 1800,
        "concurrency": 1,
        "cell_concurrency": 1
      }
    },
    {
      "id": "swe-bench-verified-sympy-codex-terra-c2-smoke",
      "description": "Two-instance SWE-bench Verified Plain Codex official-harness concurrency smoke with T=1800, K=1, C=2, R=1.",
      "benchmarks": ["swe-bench-verified"],
      "profile": "sympy-16886-19346-codex-terra-c2",
      "campaign_id_template": "swe-bench-verified-sympy-2-plain-codex-gpt-5-6-terra-30m-k1-c2-r1-{timestamp}",
      "expected_profile": {
        "task_count": 2,
        "methods": ["plain-codex"],
        "model": "gpt-5.6-terra",
        "reasoning_effort": "medium",
        "agent_provider": {
          "id": "bench_proxy",
          "name": "Benchmark OpenAI-compatible proxy",
          "auth_mode": "openai-compatible",
          "base_url_env": "OPENAI_BASE_URL",
          "api_key_env": "OPENAI_API_KEY",
          "wire_api": "responses"
        },
        "wall_time_seconds": 1800,
        "concurrency": 1,
        "cell_concurrency": 2
      }
    },
    {
      "id": "swe-bench-verified-sympy-16886-pi-smoke",
      "description": "One-instance SWE-bench Verified Plain Pi official-harness smoke with T=1800, K=1, C=1, R=1.",
      "benchmarks": ["swe-bench-verified"],
      "profile": "sympy-16886-pi-smoke",
      "campaign_id_template": "swe-bench-verified-sympy-16886-plain-pi-30m-k1-c1-r1-{timestamp}",
      "expected_profile": {
        "task_count": 1,
        "methods": ["plain-pi"],
        "model": "zai/glm-5.2",
        "reasoning_effort": "medium",
        "wall_time_seconds": 1800,
