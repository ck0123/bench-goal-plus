  "targets": [
    {
      "id": "edgebench",
      "runner": "edgebench-native",
      "adapter": null,
      "bootstrap_targets": ["edgebench"],
      "local_asset_inventory": true,
      "default_inventory_profile": "vliw-smoke",
      "docker": {
        "requirement": "required",
        "owner": "runner",
        "provision_mode": "eager",
        "scope": "Native SForge owns task work containers, hidden judges, image provisioning, and official finalization."
      }
    },
    {
      "id": "swe-bench-verified",
      "runner": "swe-bench-native",
      "adapter": null,
      "bootstrap_targets": ["swebench", "goal_plus"],
      "local_asset_inventory": true,
      "default_inventory_profile": "sympy-16886-codex-smoke",
      "docker": {
        "requirement": "required",
        "owner": "runner",
        "provision_mode": "external",
        "scope": "The Agent runs in the exact task evaluation image; the official SWE-bench harness owns a separate final evaluation container. The image is retained, and optional debug mode stops and retains the Agent container. No host-only score path is supported."
      }
    },
    {
      "id": "aibench-coding",
      "runner": "aibench-coding-native",
      "adapter": null,
      "bootstrap_targets": ["aibench_coding", "goal_plus"],
      "local_asset_inventory": true,
      "default_inventory_profile": "smoke",
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The controller grades with the locked upstream Python runtime on Linux. Agents run inside Bubblewrap with the managed aibench checkout masked; Docker is not used."
      }
    },
    {
      "id": "ale-bench-lite",
      "runner": "common-matrix",
      "adapter": "ale-bench-lite",
      "bootstrap_targets": ["ale_bench"],
      "local_asset_inventory": true,
      "default_inventory_profile": "ahc027-cpp20-202301",
      "docker": {
        "requirement": "required",
        "owner": "adapter",
        "provision_mode": "lazy",
        "scope": "The adapter invokes the benchmark-owned C++ and judge images when evaluation starts."
      }
    },
    {
      "id": "autolab-toy-isa",
      "runner": "common-matrix",
      "adapter": "autolab-toy-isa",
      "bootstrap_targets": ["autolab"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The integrated toy_isa_opt task uses the host compiler and make; other AutoLab tasks may declare their own Docker contract later."
      }
    },
    {
      "id": "frontier-cs-problem-0",
      "runner": "common-matrix",
      "adapter": "frontier-cs-problem-0",
      "bootstrap_targets": ["frontier_cs"],
      "local_asset_inventory": true,
      "default_inventory_profile": "problem-0",
      "docker": {
        "requirement": "required",
        "owner": "adapter",
        "provision_mode": "eager",
        "scope": "Setup builds the pinned Frontier-CS judge image and creates its preserved isolated evaluator container through adapter hooks."
      }
    },
    {
      "id": "frontier-engineering-malloclab",
      "runner": "common-matrix",
      "adapter": "frontier-engineering-malloclab",
      "bootstrap_targets": ["frontier_engineering"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The integrated MallocLab path uses the host C compiler and make."
      }
    },
    {
      "id": "frontier-engineering",
      "runner": "frontier-engineering-native",
      "adapter": null,
      "bootstrap_targets": ["frontier_engineering", "goal_plus"],
      "local_asset_inventory": true,
      "default_inventory_profile": "v1-lite-cpu-codex-1h",
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "Frontier-Engineering uses repository-owned uv runtimes on the Linux host and no Docker. The default inventory is the 9-task CPU subset; the full 10-task v1-lite profile explicitly opts into NVIDIA CUDA for RobotArm."
      }
    },
    {
      "id": "heurigym",
      "runner": "common-matrix",
      "adapter": "heurigym",
      "bootstrap_targets": ["heurigym"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The registered task runs in the repository-managed Python environment."
      }
    },
    {
      "id": "local-vliw",
      "runner": "common-matrix",
      "adapter": "local-vliw",
      "bootstrap_targets": ["goal_plus"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "This local diagnostic task uses repository-hosted fixtures and tools."
      }
    },
    {
      "id": "openevolve-cpu-portable",
      "runner": "openevolve-batch",
      "adapter": null,
      "bootstrap_targets": ["openevolve"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The screened cpu_portable task set runs in the locked NumPy/SciPy environment without Docker."
      }
    },
    {
      "id": "torchbench",
      "runner": "common-matrix",
      "adapter": "torchbench",
      "bootstrap_targets": ["torchbench", "goal_plus"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The adapter runs TorchBench eval workloads in a user-supplied CUDA Python environment on the host; it does not use Docker or modify the managed upstream checkout."
      }
    },
    {
      "id": "zsoft-l1",
      "runner": "common-matrix",
      "adapter": "zsoft-l1",
      "bootstrap_targets": ["zsoft_l1", "goal_plus"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "required",
        "owner": "adapter",
        "provision_mode": "lazy",
        "scope": "The benchmark-owned zsoft-poc evaluator builds vulnerable and fixed images with Docker Compose per evaluation."
      }
    },
    {
      "id": "zsoft-detect",
      "runner": "common-matrix",
      "adapter": "zsoft-detect",
      "bootstrap_targets": ["zsoft_l1", "goal_plus"],
      "local_asset_inventory": false,
      "docker": {
        "requirement": "not_required",
        "owner": "adapter",
        "provision_mode": "none",
        "scope": "The benchmark-owned deterministic submission scorer runs on the host."
      }
    },
    {
      "id": "zsoft-detect-swe-agent",
      "runner": "zsoft-detect-native",
      "adapter": null,
      "bootstrap_targets": ["zsoft_l1"],
      "local_asset_inventory": true,
      "default_inventory_profile": "civetweb-swe-agent-smoke",
      "docker": {
        "requirement": "not_required",
        "owner": "host",
        "provision_mode": "none",
        "scope": "The benchmark-owned SWE-agent launcher runs natively on a Linux host inside Bubblewrap and calls the deterministic host scorer; Docker and OrbStack are not execution substitutes."
      }
    }
  ],
