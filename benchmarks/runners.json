{
  "schema_version": 2,
  "runners": [
    {
      "id": "edgebench-native",
      "kind": "native-profile",
      "controller": "experiments/edgebench/experiment.py",
      "evidence_filename": "comparison.json",
      "supported_methods": [
        "plain-codex",
        "goal-plus-codex",
        "plain-claude",
        "plain-pi",
        "plain-pi-provider",
        "goal-plus-pi",
        "goal-plus-pi-provider"
      ],
      "method_contracts": {
        "goal-plus-codex": {
          "runtime_source_command": "plan-metadata"
        },
        "plain-pi-provider": {
          "model_format": "provider/model"
        },
        "goal-plus-pi": {
          "runtime_source_command": "plan-metadata"
        },
        "goal-plus-pi-provider": {
          "model_format": "provider/model",
          "runtime_source_command": "plan-metadata"
        }
      },
      "capabilities": {
        "provision": true,
        "detach": true,
        "stop": true,
        "resume": false,
        "repeat_seeds": false,
        "cell_concurrency": true,
        "retain_containers": false,
        "official_evaluator": true,
        "attempt_seed": false,
        "resume_semantics": "stopped campaigns are finalized as partial; retry uses a new campaign"
      }
    },
    {
      "id": "swe-bench-native",
