#!/usr/bin/env python3
"""Reserve ZSoft selection and promotion for the host controller."""

from __future__ import annotations

import json
import os
import sys


CONTROLLER_ONLY_CLOSEOUT_ENV = "BENCH_GOAL_PLUS_CONTROLLER_ONLY_CLOSEOUT"
CONTROLLER_ONLY_TOOLS = {
    "goal_plus_record_search_result",
    "goal_plus_set_status",
    "search_promote",
    "search_report",
    "search_select",
}


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    tool = arguments[-1] if arguments else None
    if (
        os.environ.get(CONTROLLER_ONLY_CLOSEOUT_ENV) == "1"
        and tool in CONTROLLER_ONLY_TOOLS
    ):
        print(
            json.dumps(
                {
                    "ok": False,
                    "tool": tool,
                    "error": "ZSoft closeout is reserved for the host controller",
                }
            ),
            file=sys.stderr,
        )
        return 1

    from goal_plus.pi_tool import main as goal_plus_pi_tool_main

    return goal_plus_pi_tool_main(arguments)


if __name__ == "__main__":
    raise SystemExit(main())
