#!/usr/bin/env node
/*
 * Loopback-only LLM relay wrapper for benchmark Pi workers.
 *
 * Runs INSIDE the bubblewrap sandbox as the wrapped entrypoint:
 *
 *   llm-relay -- <original-command> [args...]
 *
 * Responsibilities:
 *   1. bring the (otherwise down) loopback interface up;
 *   2. run a startup network canary and log the result to stderr so every
 *      cell carries in-band evidence that egress was blocked;
 *   3. serve http://127.0.0.1:$PORT and forward every request verbatim to
 *      the host-side relay over the private unix socket
 *      ($BENCH_GOAL_PLUS_PI_LLM_RELAY_SOCKET), which is the only path out;
 *   4. scrub proxy-related environment variables and exec the original
 *      command (the Pi worker) with inherited stdio.
 *
 * The sandbox network namespace has no external route at all, so this relay
 * is the single egress path and it only ever talks to the allowlisted
 * upstream configured host-side.
 */

"use strict";

const http = require("node:http");
const https = require("node:https");
const net = require("node:net");
const { spawn, spawnSync } = require("node:child_process");

const RELAY_PORT = Number(process.env.BENCH_GOAL_PLUS_PI_LLM_RELAY_PORT || 8787);
const RELAY_SOCKET = process.env.BENCH_GOAL_PLUS_PI_LLM_RELAY_SOCKET || "";
const CANARY_URL = "https://raw.githubusercontent.com/torvalds/linux/master/README";
const CANARY_TIMEOUT_MS = 4000;
const MAX_RESPONSE_BYTES = 64 * 1024 * 1024;

function log(message) {
  process.stderr.write(`[llm-relay] ${message}\n`);
}

function bringLoopbackUp() {
  try {
    spawnSync("ip", ["link", "set", "lo", "up"], { stdio: "ignore" });
  } catch (_) {
    /* best effort; binding 127.0.0.1 will fail loudly if this mattered */
  }
}

function canary() {
  return new Promise((resolve) => {
    let settled = false;
    const done = (verdict) => {
      if (!settled) {
        settled = true;
        resolve(verdict);
      }
    };
    try {
      const req = https.get(CANARY_URL, (res) => {
        res.destroy();
        done(`NOT-BLOCKED status=${res.statusCode}`);
      });
      req.setTimeout(CANARY_TIMEOUT_MS, () => {
        req.destroy();
        done("blocked(timeout)");
      });
      req.on("error", (err) => done(`blocked(${err.code || err.message})`));
    } catch (err) {
      done(`blocked(${err.code || err.message})`);
    }
    setTimeout(() => done("blocked(timeout)"), CANARY_TIMEOUT_MS + 500).unref();
  });
}

class SocketReader {
  constructor(socket) {
    this.socket = socket;
    this.buffer = Buffer.alloc(0);
    this.waiter = null;
    socket.on("data", (chunk) => {
      this.buffer = this.buffer.length === 0 ? chunk : Buffer.concat([this.buffer, chunk]);
      this._drain();
    });
    socket.on("end", () => this._fail(new Error("relay socket ended early")));
    socket.on("error", () => this._fail(new Error("relay socket error")));
  }

  _fail(err) {
    const waiter = this.waiter;
    this.waiter = null;
    if (waiter) waiter.reject(err);
  }

  _drain() {
    const waiter = this.waiter;
    if (!waiter || this.buffer.length < waiter.length) return;
    this.waiter = null;
    const out = this.buffer.subarray(0, waiter.length);
    this.buffer = this.buffer.subarray(waiter.length);
    waiter.resolve(out);
  }

  readExact(length) {
    if (this.buffer.length >= length) {
      const out = this.buffer.subarray(0, length);
      this.buffer = this.buffer.subarray(length);
      return Promise.resolve(out);
    }
    return new Promise((resolve, reject) => {
      this.waiter = { length, resolve, reject };
    });
  }
}

function relayRequest(req, bodyBuffer, res) {
  if (!RELAY_SOCKET) {
    res.writeHead(502, { "content-type": "text/plain" });
    res.end("llm-relay: no relay socket configured");
    return;
  }
  const socket = net.connect(RELAY_SOCKET);
  socket.setTimeout(600000);
  const header = {
    method: req.method,
    path: req.url,
    headers: req.headers,
  };
  const magic = Buffer.from("BGPLLM1\n", "utf8");
  const headerLine = Buffer.from(JSON.stringify(header) + "\n", "utf8");
  const lengthPrefix = Buffer.alloc(8);
  lengthPrefix.writeBigUInt64BE(BigInt(bodyBuffer.length));

  socket.on("error", (err) => {
    log(`upstream socket error: ${err.code || err.message}`);
    try {
      res.writeHead(502, { "content-type": "text/plain" });
      res.end(`llm-relay: relay socket failed (${err.code || err.message})`);
    } catch (_) {
      /* client already gone */
    }
  });

  socket.on("connect", async () => {
    try {
      socket.write(magic);
      socket.write(headerLine);
      socket.write(lengthPrefix);
      socket.write(bodyBuffer);
      const reader = new SocketReader(socket);
      const lenBuf = await reader.readExact(4);
      const headerLength = lenBuf.readUInt32BE(0);
      if (headerLength === 0 || headerLength > 65536) {
        throw new Error("malformed relay response header length");
      }
      const headerBuf = await reader.readExact(headerLength);
      let responseHeader;
      try {
        responseHeader = JSON.parse(headerBuf.toString("utf8"));
      } catch (_) {
        throw new Error("malformed relay response header");
      }
      const bodyLenBuf = await reader.readExact(8);
      const bodyLength = Number(bodyLenBuf.readBigUInt64BE(0));
      if (bodyLength > MAX_RESPONSE_BYTES) {
        throw new Error("relay response too large");
      }
      const body =
        bodyLength === 0 ? Buffer.alloc(0) : await reader.readExact(bodyLength);
      res.writeHead(responseHeader.status || 502, responseHeader.headers || {});
      res.end(body);
      socket.destroy();
    } catch (err) {
      log(`relay exchange failed: ${err.message}`);
      try {
        res.writeHead(502, { "content-type": "text/plain" });
        res.end(`llm-relay: ${err.message}`);
      } catch (_) {
        /* client already gone */
      }
      socket.destroy();
    }
  });
}

async function main() {
  const argv = process.argv.slice(2);
  const dash = argv.indexOf("--");
  const childArgv = dash >= 0 ? argv.slice(dash + 1) : argv;
  if (childArgv.length === 0) {
    log("missing original command after --");
    process.exit(2);
  }

  bringLoopbackUp();
  const verdict = await canary();
  log(`network canary: ${verdict}`);

  for (const name of [
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "http_proxy",
    "https_proxy",
    "all_proxy",
  ]) {
    delete process.env[name];
  }
  process.env.NO_PROXY = "*";
  process.env.no_proxy = "*";

  const server = http.createServer((req, res) => {
    const chunks = [];
    req.on("data", (chunk) => chunks.push(chunk));
    req.on("end", () => relayRequest(req, Buffer.concat(chunks), res));
    req.on("error", () => res.destroy());
  });
  server.on("clientError", (err, socket) => {
    socket.end("HTTP/1.1 400 Bad Request\r\n\r\n");
  });

  await new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(RELAY_PORT, "127.0.0.1", () => resolve());
  });
  log(`listening on http://127.0.0.1:${RELAY_PORT} via ${RELAY_SOCKET}`);

  const child = spawn(childArgv[0], childArgv.slice(1), {
    stdio: "inherit",
    env: process.env,
  });
  const forward = (signal) => {
    if (child.exitCode === null && !child.killed) child.kill(signal);
  };
  process.on("SIGTERM", () => forward("SIGTERM"));
  process.on("SIGINT", () => forward("SIGINT"));
  child.on("exit", (code, signal) => {
    server.close();
    process.exit(code === null ? (signal ? 128 + 2 : 1) : code);
  });
}

main().catch((err) => {
  log(`fatal: ${err && err.stack ? err.stack : err}`);
  process.exit(2);
});
